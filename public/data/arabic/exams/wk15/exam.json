        {
         "t": "text",
         "text": "مُقَاتِل = [[م:box,tiny]] / [[ق:box,tiny]] / [[ا:box,tiny]] / [[ت:box,tiny]] / [[ل:box,tiny]]"
        }
       ]
      }
     ]
    },
    {
