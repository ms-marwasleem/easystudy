     "t": "q",
     "n": "١",
     "text": "اقرأ ثم أجب: (هَذِهِ مُعَلِّمَتِي هِنْدُ، أُحِبُّ مُعَلِّمَتِي، وَأَنْتَبِهُ إِلَى شَرْحِ الدَّرْسِ) هات من العبارة:",
     "audio": "q1.mp3",
     "body": [
      {
       "t": "row",
       "cols": 2,
       "style": "",
       "items": [
        {
         "t": "text",
         "text": "كلمة بها حرف (ح): [[أحب|شرح]]"
        },
        {
         "t": "text",
         "text": "كلمة بها حرف (ع): [[معلمتي|معلمتي،]]"
        }
       ]
      }
     ]
    },
    {
     "t": "q",
     "n": "٢",
     "text": "أكمل بكلمة من النشيد:",
     "audio": "q2.mp3",
     "body": [
      {
       "t": "row",
       "cols": 4,
       "style": "",
       "items": [
        {
         "t": "text",
         "text": "أنا تلميذ [[في]] مدرستي"
        },
        {
         "t": "text",
         "text": "أرسم [[شمسا]]"
        },
        {
         "t": "text",
         "text": "أردد [[خلف]] معلمتي"
        },
        {
         "t": "text",
         "text": "قلمي في [[مقلمتي]]"
        }
       ]
      }
     ]
    },
    {
     "t": "q",
     "n": "٣",
     "text": "حلل الكلمات الآتية إلى حروف:",
