     "body": [
      {
       "t": "row",
       "cols": 2,
       "style": "",
       "items": [
        {
         "t": "text",
         "text": "عَسَلُ = [[ع:box,tiny]] / [[س:box,tiny]] / [[ل:box,tiny]]"
        },
        {
         "t": "text",
         "text": "شَرَاعُ = [[ش:box,tiny]] / [[ر:box,tiny]] / [[ا:box,tiny]] / [[ع:box,tiny]]"
        },
        {
         "t": "text",
         "text": "شُبَّاكُ = [[ش:box,tiny]] / [[ب:box,tiny]] / [[ب:box,tiny]] / [[ا:box,tiny]] / [[ك:box,tiny]]"
        },
        {
         "t": "text",
         "text": "خَرُوفُ = [[خ:box,tiny]] / [[ر:box,tiny]] / [[و:box,tiny]] / [[ف:box,tiny]]"
        }
       ]
      }
     ]
    },
    {
