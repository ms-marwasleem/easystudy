{
  "name": "easywords",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "vars": { "APP_ID": "words", "APP_NAME": "Easy Words", "ROOT_PAGE": "/words.html", "ADMIN_PAGE": "/admin-words.html", "STUDY_ORIGIN": "https://easystudy.marwasleem.workers.dev" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/admin.html", "/admin", "/admin/", "/admin-words.html", "/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "easystudy", "database_id": "40053f36-559b-4403-b147-468b04d3f838" },
    { "binding": "WORDS_OLD", "database_name": "easywords", "database_id": "946ec279-7baf-469a-87e4-f67f8a90009a" }
  ]
}
